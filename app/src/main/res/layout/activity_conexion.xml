<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de enlaces inalámbricos:
   - Otro teléfono (Conductor <-> Operador) por Wi-Fi o Bluetooth.
   - Placa Arduino UNO R3 con módulo HC-05 por Bluetooth.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".ui.ConexionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnVolverConexion"
            style="@style/Boton.Texto"
            android:text="@string/btn_volver" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/conexion_titulo"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============ Teléfono a teléfono ============ -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    android:id="@+id/tvTituloTelefono"
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Conectar con el teléfono del Operador" />

                <TextView
                    android:id="@+id/tvEstadoTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@drawable/punto_estado"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    tools:text="Estado: Desconectado" />

                <TextView
                    android:id="@+id/tvDetalleTelefono"
                    style="@style/Texto.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/rgMedio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checkedButton="@+id/rbWifi"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbWifi"
                        style="@style/Opcion"
                        android:text="@string/medio_wifi" />

                    <RadioButton
                        android:id="@+id/rbBluetooth"
                        style="@style/Opcion"
                        android:text="@string/medio_bt" />
                </RadioGroup>

                <!-- Rol Operador: muestra PIN e IP y abre el servidor -->
                <LinearLayout
                    android:id="@+id/grupoServidor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvPinOperador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cian_conexion"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="PIN de vinculación: 123456" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ayuda_pin_operador" />

                    <TextView
                        android:id="@+id/tvIpLocal"
                        style="@style/Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="IP de este teléfono: 192.168.43.1 · puerto 5050" />

                    <Button
                        android:id="@+id/btnIniciarServidor"
                        style="@style/Boton.Primario"
                        android:text="@string/btn_servidor_wifi" />
                </LinearLayout>

                <!-- Rol Conductor: ingresa PIN (e IP si es Wi-Fi) -->
                <LinearLayout
                    android:id="@+id/grupoCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:labelFor="@+id/etPin"
                        android:text="@string/campo_pin" />

                    <EditText
                        android:id="@+id/etPin"
                        style="@style/Campo"
                        android:hint="@string/hint_pin"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:maxLength="6" />

                    <LinearLayout
                        android:id="@+id/grupoIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:labelFor="@+id/etIp"
                            android:text="@string/campo_ip" />

                        <EditText
                            android:id="@+id/etIp"
                            style="@style/Campo"
                            android:digits="0123456789."
                            android:importantForAutofill="no"
                            android:inputType="number|numberDecimal"
                            android:maxLength="15"
                            android:text="192.168.43.1" />

                        <Button
                            android:id="@+id/btnConectarWifi"
                            style="@style/Boton.Primario"
                            android:text="@string/btn_conectar_wifi" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAyudaBtTelefono"
                    style="@style/Texto.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/vincular_bt"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnPermisoBtTelefono"
                    style="@style/Boton.Primario"
                    android:text="@string/btn_permiso_bt"
                    android:visibility="gone" />

                <!-- Dispositivos vinculados (botones desde item_dispositivo.xml) -->
                <LinearLayout
                    android:id="@+id/listaDispositivosTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnDesconectarTelefono"
                    style="@style/Boton.Secundario"
                    android:text="@string/btn_desconectar"
                    android:textColor="@color/rojo_ocupado"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============ Arduino UNO R3 ============ -->
            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arduino_titulo" />

                <TextView
                    android:id="@+id/tvEstadoArduino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@drawable/punto_estado"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    tools:text="Estado: Desconectado" />

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/arduino_ayuda" />

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:labelFor="@+id/etClaveArduino"
                    android:text="@string/campo_clave_arduino" />

                <EditText
                    android:id="@+id/etClaveArduino"
                    style="@style/Campo"
                    android:hint="@string/hint_clave_arduino"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/tvAvisoArduino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ambar_reservado"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnPermisoBtArduino"
                    style="@style/Boton.Primario"
                    android:text="@string/btn_permiso_bt"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/listaDispositivosArduino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnDesconectarArduino"
                    style="@style/Boton.Secundario"
                    android:text="@string/btn_desconectar"
                    android:textColor="@color/rojo_ocupado"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/consejo_hotspot"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
