<?xml version="1.0" encoding="utf-8"?>
<!-- Celda de una plaza del mapa. Se infla desde ConductorActivity / OperadorActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_plaza_libre"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/tvPlazaNumero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="7" />

    <TextView
        android:id="@+id/tvPlazaEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/verde_libre"
        android:textSize="12sp"
        tools:text="Libre" />
</LinearLayout>
