<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    tools:context=".ui.RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolver"
                style="@style/Boton.Texto"
                android:text="@string/btn_volver" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/registro_titulo" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tipo_cuenta" />

        <RadioGroup
            android:id="@+id/rgRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/rbConductor"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbConductor"
                style="@style/Opcion"
                android:text="@string/rol_conductor" />

            <RadioButton
                android:id="@+id/rbOperador"
                style="@style/Opcion"
                android:text="@string/rol_operador" />
        </RadioGroup>

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/etRegUsuario"
            android:text="@string/campo_usuario" />

        <EditText
            android:id="@+id/etRegUsuario"
            style="@style/Campo"
            android:autofillHints="username"
            android:hint="@string/hint_usuario"
            android:inputType="text|textNoSuggestions"
            android:maxLength="20" />

        <TextView
            android:id="@+id/tvAyudaUsuario"
            style="@style/Texto.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ayuda_usuario"
            android:textSize="12sp" />

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/etRegPassword"
            android:text="@string/campo_password" />

        <EditText
            android:id="@+id/etRegPassword"
            style="@style/Campo"
            android:autofillHints="password"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:maxLength="64" />

        <TextView
            android:id="@+id/tvAyudaPassword"
            style="@style/Texto.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ayuda_password"
            android:textSize="12sp" />

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/etRegConfirmacion"
            android:text="@string/campo_confirmacion" />

        <EditText
            android:id="@+id/etRegConfirmacion"
            style="@style/Campo"
            android:autofillHints="password"
            android:hint="@string/campo_confirmacion"
            android:inputType="textPassword"
            android:maxLength="64" />

        <TextView
            android:id="@+id/tvAyudaConfirmacion"
            style="@style/Texto.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Solo para el rol Conductor -->
        <LinearLayout
            android:id="@+id/grupoPatente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etPatente"
                android:text="@string/campo_patente" />

            <EditText
                android:id="@+id/etPatente"
                style="@style/Campo"
                android:hint="@string/hint_patente"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="8" />

            <TextView
                android:id="@+id/tvAyudaPatente"
                style="@style/Texto.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_patente"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Solo para el rol Operador -->
        <LinearLayout
            android:id="@+id/grupoCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etCodigo"
                android:text="@string/campo_codigo" />

            <EditText
                android:id="@+id/etCodigo"
                style="@style/Campo"
                android:hint="@string/campo_codigo"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLength="20" />

            <TextView
                android:id="@+id/tvAyudaCodigo"
                style="@style/Texto.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ayuda_codigo"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvErrorRegistro"
            style="@style/Texto.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRegistrar"
            style="@style/Boton.Primario"
            android:layout_marginTop="20dp"
            android:text="@string/btn_crear_cuenta" />

        <ProgressBar
            android:id="@+id/pbRegistro"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/verde_libre"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
