<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal Android 2: Operador. Telemetría, control de barreras y log de eventos (OT). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".ui.OperadorActivity">

    <include
        android:id="@+id/encabezado"
        layout="@layout/include_encabezado" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/Tarjeta" android:layout_marginTop="0dp">

                <include
                    android:id="@+id/enlaces"
                    layout="@layout/include_enlaces" />

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/red_cifrada"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Indicadores (KPI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_aforo" />

                    <TextView
                        android:id="@+id/tvKpiAforo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cian_conexion"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/tvKpiAforoSub"
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="11sp"
                        tools:text="ocupación" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_libres" />

                    <TextView
                        android:id="@+id/tvKpiLibres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/verde_libre"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/tvKpiLibresSub"
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="11sp"
                        tools:text="ocupación" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_reservas" />

                    <TextView
                        android:id="@+id/tvKpiReservas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ambar_reservado"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/tvKpiReservasSub"
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="11sp"
                        tools:text="ocupación" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Tarjeta">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_barreras" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/barrera_entrada" />

                        <TextView
                            android:id="@+id/tvEstadoEntrada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto_secundario"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="CERRADA" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swEntrada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/barrera_entrada"
                        android:thumbTint="@color/verde_libre" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/barrera_salida" />

                        <TextView
                            android:id="@+id/tvEstadoSalida"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto_secundario"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="CERRADA" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swSalida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/barrera_salida"
                        android:thumbTint="@color/verde_libre" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/plazas_contingencia" />

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/leyenda"
                android:textSize="12sp" />

            <!-- Grilla de 4 columnas con las 24 plazas (celdas desde item_plaza.xml) -->
            <GridLayout
                android:id="@+id/gridPlazasOperador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="4" />

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/log_eventos" />

            <Spinner
                android:id="@+id/spFiltroEventos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_campo"
                android:popupBackground="@color/superficie_alta"
                android:spinnerMode="dropdown" />

            <LinearLayout style="@style/Tarjeta" android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvSinEventos"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sin_eventos" />

                <!-- Filas desde item_evento.xml -->
                <LinearLayout
                    android:id="@+id/contenedorEventos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
