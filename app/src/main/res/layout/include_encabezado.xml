<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado común de Conductor y Operador: título, subtítulo y acciones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            tools:text="SmartPark IoT" />

        <TextView
            android:id="@+id/tvSubtitulo"
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Hola, conductor · ABCD12" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConexion"
        style="@style/Boton.Texto"
        android:text="@string/btn_conexion" />

    <Button
        android:id="@+id/btnSalir"
        style="@style/Boton.Texto"
        android:text="@string/btn_salir"
        android:textColor="@color/rojo_ocupado" />
</LinearLayout>
