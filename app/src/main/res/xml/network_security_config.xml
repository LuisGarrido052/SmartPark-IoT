<?xml version="1.0" encoding="utf-8"?>
<!-- ISO 27400: se prohíbe tráfico HTTP sin cifrar. El canal entre teléfonos usa sockets propios cifrados con AES-GCM. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
