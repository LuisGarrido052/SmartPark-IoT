<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base del framework (sin librerías extra) para máxima compatibilidad con Android Studio de los laboratorios. -->
    <style name="Base.Theme.Estacionamiento" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/verde_libre</item>
        <item name="android:colorPrimaryDark">@color/fondo</item>
        <item name="android:colorAccent">@color/verde_libre</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:alertDialogTheme">@style/Dialogo.Estacionamiento</item>
    </style>

    <style name="Theme.Estacionamiento" parent="Base.Theme.Estacionamiento" />

    <style name="Dialogo.Estacionamiento" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/verde_libre</item>
        <item name="android:colorBackground">@color/superficie</item>
        <item name="android:textColorPrimary">@color/texto</item>
    </style>

    <!-- ===== Estilos reutilizables de las vistas XML ===== -->
    <style name="Texto.Titulo" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Seccion" parent="android:TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Cuerpo" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Texto.Secundario" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Texto.Etiqueta" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Texto.Error" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/rojo_ocupado</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_tarjeta</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Boton.Primario" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_boton_primario</item>
        <item name="android:textColor">@color/texto_sobre_primario</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Boton.Secundario" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_boton_secundario</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Boton.Texto" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/verde_libre</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Opcion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:buttonTint">@color/verde_libre</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
